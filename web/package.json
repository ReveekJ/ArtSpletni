    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.21"
