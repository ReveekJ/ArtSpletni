    "clsx": "^2.1.1",
    "i18next": "^27.1.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.73.0",
    "openapi-fetch": "^0.17.0",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.8",
